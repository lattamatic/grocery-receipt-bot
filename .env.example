# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Telegram bot token (from @BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Google Gemini API key (free — https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: models tried in order (this is the default)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Optional: comma-separated Telegram chat IDs allowed to use the bot (send /start to see yours)
# ALLOWED_CHAT_IDS=123456789

# Google Sheets
SPREADSHEET_ID=your-spreadsheet-id-here
SHEET_NAME=Sheet1
# Optional: currency used when the receipt does not show one (default EUR)
# DEFAULT_CURRENCY=EUR

# Google Service Account JSON — paste the entire JSON on one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
